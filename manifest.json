{
  "manifest_version": 3,
  "name": "DOM Sentinel - Webpage Change Watcher",
  "version": "1.4.0",
  "description": "Monitors webpages at custom second intervals, detects DOM changes, alerts with loud acoustic alarm, and halts reloading. Compatible with Brave, Chrome, Firefox, and Edge.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DOM Sentinel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dom-sentinel@fabriciojsil.github.io",
      "strict_min_version": "121.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
